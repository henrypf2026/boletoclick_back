# ============================================================
# NEWSLETTER CRON
#
# Formato:
# ┌──────── minuto (0 - 59)
# │ ┌────── hora (0 - 23)
# │ │ ┌──── día del mes (1 - 31)
# │ │ │ ┌── mes (1 - 12)
# │ │ │ │ ┌ día de la semana (0 - 6)
# │ │ │ │ │
# * * * * *
#
# Días de la semana:
# 0 = Domingo
# 1 = Lunes
# 2 = Martes
# 3 = Miércoles
# 4 = Jueves
# 5 = Viernes
# 6 = Sábado
#
# Ejemplo:
#
# 15 17 * * 1 -> Lunes 17:15
NEWSLETTER_CRON_FRECUENCY=15 17 * * 1

